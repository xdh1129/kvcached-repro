# Experiment settings, sourced by scripts/*.sh. Any value can be overridden
# from the environment, e.g. `GPU_ID=3 bash scripts/run_experiment.sh kvcached`.

# GPU that hosts all instances. GPU 0 is often occupied by a shared vLLM service.
GPU_ID=${GPU_ID:-1}

# Upstream uses meta-llama/Llama-3.1-8B-Instruct (gated). Qwen3-8B is an
# ungated 8B GQA model of similar size; set MODEL to the Llama checkpoint once
# the HF token has access.
MODEL=${MODEL:-Qwen/Qwen3-8B}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-32768}

# One vLLM instance per port, all on GPU_ID (upstream uses 3 instances).
PORTS=(${PORTS:-12346 30000 40000})

# Static baseline: fixed fraction of GPU memory per instance (upstream: 0.31).
STATIC_GPU_MEM_UTIL=${STATIC_GPU_MEM_UTIL:-0.31}

# kvcached settings, matching upstream bench-config.yaml.
KVCACHED_GPU_UTILIZATION=${KVCACHED_GPU_UTILIZATION:-0.95}
KVCACHED_MIN_RESERVED_PAGES=${KVCACHED_MIN_RESERVED_PAGES:-5}
KVCACHED_MAX_RESERVED_PAGES=${KVCACHED_MAX_RESERVED_PAGES:-10}

# Workload: ramp-up-down per model, staggered start (upstream run_benchmark.sh).
PEAK_RPS=${PEAK_RPS:-16}
PROMPT_LEN=${PROMPT_LEN:-256}
COMPLETION_LEN=${COMPLETION_LEN:-512}
# 1: every request decodes exactly COMPLETION_LEN tokens (deterministic KV
# pressure). Upstream does not set this; use 0 to match it exactly.
IGNORE_EOS=${IGNORE_EOS:-1}

# VRAM sampling interval in seconds.
SAMPLE_INTERVAL=${SAMPLE_INTERVAL:-0.5}
